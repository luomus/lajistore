{
  "settings": {
    "number_of_shards": 3,
    "index.mapping.ignore_malformed": true,
    "index.max_result_window": 1000000,
    "index.mapping.total_fields.limit": 10000,
    "index.mapping.nested_objects.limit": 100000,
    "analysis": {
      "normalizer": {
        "useLowercase": {
          "type": "custom",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "@context": {
        "type": "keyword"
      },
      "id": {
        "type": "keyword",
        "normalizer": "useLowercase"
      },
      "@type": {
        "type": "keyword"
      },
      "accessionID": {
        "type": "keyword",
        "ignore_above": 200,
        "normalizer": "useLowercase"
      },
      "collectionID": {
        "type": "keyword",
        "ignore_above": 200,
        "normalizer": "useLowercase"
      },
      "exists": {
        "type": "boolean"
      },
      "gardenLocationNotes": {
        "type": "keyword",
        "ignore_above": 200,
        "normalizer": "useLowercase"
      },
      "location": {
        "type": "keyword",
        "ignore_above": 200,
        "normalizer": "useLowercase"
      },
      "notes": {
        "type": "keyword",
        "ignore_above": 200,
        "normalizer": "useLowercase"
      },
      "wgs84Latitude": {
        "type": "keyword",
        "ignore_above": 200,
        "normalizer": "useLowercase"
      },
      "wgs84Longitude": {
        "type": "keyword",
        "ignore_above": 200,
        "normalizer": "useLowercase"
      },
      "events": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "amount": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "amountEstimationUnit": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "branchID": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "date": {
            "type": "date"
          },
          "eRH": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "estimatedSeedQuantity": {
            "type": "integer"
          },
          "eventType": {
            "type": "keyword",
            "ignore_above": 200
          },
          "germinationConditions": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "germinationPercentage": {
            "type": "integer"
          },
          "germinationRate": {
            "type": "float"
          },
          "lifeStage": {
            "type": "keyword",
            "ignore_above": 200
          },
          "notes": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "numberOfSeedsEmpty": {
            "type": "integer"
          },
          "numberOfSeedsFull": {
            "type": "integer"
          },
          "numberOfSeedsInfested": {
            "type": "integer"
          },
          "numberOfSeedsMouldy": {
            "type": "integer"
          },
          "numberOfSeedsPartFull": {
            "type": "integer"
          },
          "numberOfSeedsTested": {
            "type": "integer"
          },
          "percentageSeedsFull": {
            "type": "integer"
          },
          "seedsExchangedInstitution": {
            "type": "keyword",
            "ignore_above": 200,
            "normalizer": "useLowercase"
          },
          "testPassed": {
            "type": "boolean"
          },
          "viabilityPercentage": {
            "type": "integer"
          }
        }
      },
      "_meta": {
        "properties": {
          "created": {
            "type": "date"
          },
          "edited": {
            "type": "date"
          }
        }
      }
    }
  }
}